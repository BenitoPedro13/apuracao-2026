{
  "name": "@apuracao/web",
  "version": "0.0.0",
  "description": "The public dashboard: Next.js static export over the published views",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check-types": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "serve-data": "node e2e/serve.ts ../../.replay/real/pub 3001",
    "perf:build": "NEXT_PUBLIC_DATA_BASE_URL=http://127.0.0.1:3001 next build && rm -rf .perf && mv out .perf && next build",
    "test:perf": "playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@apuracao/contracts": "workspace:*",
    "@apuracao/tse": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "3.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apuracao/config": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
