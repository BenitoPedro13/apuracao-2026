# Every environment variable the code reads. Copy to .env (gitignored) and fill in.

# infra/: address the AWS Budget alerts are emailed to. Required by every `cdk synth/deploy`.
ALERT_EMAIL=

# apps/recorder (defaults in apps/recorder/src/config.ts; the AWS task sets the first four)
RAW_BUCKET=                 # apuracao26-raw-860897618882 in AWS; any bucket locally
AWS_REGION=sa-east-1
RATE_MAX=10                 # req/s ceiling; 10 for the capture and soak, 100 on the night
OBJECT_LOCK_YEARS=10        # 0 for the local emulator
RECORDER_ID=                # default: hostname (unique per Fargate task)
RECORDER_TARGETS=6257:1:600,6259:3:600,6258:1:expires,6260:3:expires,6259:5:600:uf,6259:6:600:uf,6259:7:600:uf,6259:8:600:uf
S3_ENDPOINT=                # local only, e.g. http://localhost:9000 (RustFS in docker compose)
TSE_BASE_URL=               # default https://resultados.tse.jus.br/oficial/; fake-tse in tests
TSE_TEST_JWK_URL=           # replays only: fake-tse's test key (…/app/assets/assinatura-jws/test.jwk.json).
                            # Refused at start with a production bucket (apuracao26-raw-*, apuracao26-pub)
CONCURRENCY=16
FLUSH_MS=5000
HEARTBEAT_MS=60000
SNAPSHOT_MS=60000
LEASE_TTL_MS=30000
LEASE_RENEW_MS=10000

# apps/projector (defaults in apps/projector/src/config.ts). Also reads RAW_BUCKET,
# AWS_REGION and S3_ENDPOINT above.
ELECTIONS=president=6257,governor=6259   # required, no default: the night is president=6258,governor=6260
GOVERNOR_UFS=               # default: the 7 runoff UFs for 6260, all 27 for 6259
PUB_BUCKET=                 # apuracao26-pub-<account> in AWS (PublicStack); or set PUB_DIR
PUB_DIR=                    # local directory standing in for the public bucket
PROJECTOR_ID=               # default: hostname
EPOCH=s3-1                  # a new epoch for any rebuild or ELECTIONS change
PROMOTE=false               # true: replace a pointer that belongs to another epoch
TAIL_MS=2000                # how often the S3 tail lists new segments
LOOKBACK_MS=600000          # the tail re-lists this far back (late segment PUTs)
QUIET_MS=2000               # publish after this long without changes…
MAX_DELAY_MS=10000          # …or at most this long after the first unpublished change
CHECKPOINT_EVERY=50         # publishes between checkpoints
POINTER_REFRESH_MS=60000
BLOB_CONCURRENCY=32
BLOB_CACHE_MB=200
POLL_SECONDS=20             # tells browsers how often to poll the pointer
# TSE_TEST_JWK_URL (above) is read by the projector too, with the same refusal.

# apps/web (inlined at build time)
NEXT_PUBLIC_DATA_BASE_URL=  # default: plan B, https://apuracao26-pub-860897618882.s3.sa-east-1.amazonaws.com;
                            # the CloudFront URL once cdn=on; http://127.0.0.1:3001 for `serve-data`
