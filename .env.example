# Every environment variable the code reads. Copy to .env (gitignored) and fill in.

# infra/: address the AWS Budget alerts are emailed to. Required by every `cdk synth/deploy`.
ALERT_EMAIL=

# apps/recorder (defaults in apps/recorder/src/config.ts; the AWS task sets the first four)
RAW_BUCKET=                 # apuracao26-raw-860897618882 in AWS; any bucket locally
AWS_REGION=sa-east-1
RATE_MAX=10                 # req/s ceiling; 10 for the capture and soak, 100 on the night
OBJECT_LOCK_YEARS=10        # 0 for the local emulator
RECORDER_ID=                # default: hostname (unique per Fargate task)
RECORDER_TARGETS=6257:1:600,6259:3:600,6258:1:expires,6260:3:expires
S3_ENDPOINT=                # local only, e.g. http://localhost:9000 (RustFS in docker compose)
TSE_BASE_URL=               # default https://resultados.tse.jus.br/oficial/; fake-tse in tests
CONCURRENCY=16
FLUSH_MS=5000
HEARTBEAT_MS=60000
SNAPSHOT_MS=60000
LEASE_TTL_MS=30000
LEASE_RENEW_MS=10000
