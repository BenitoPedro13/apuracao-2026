{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        "cdk.out/**",
        "out/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "ALERT_EMAIL",
        "CDK_DEFAULT_ACCOUNT",
        "NEXT_PUBLIC_DATA_BASE_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/research/samples/**"
      ]
    }
  }
}
