{
  "name": "@apuracao/fake-tse",
  "version": "0.0.0",
  "description": "Test harness: replays real captured TSE files with TSE HTTP semantics, staged reveal and faults",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@apuracao/config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@apuracao/contracts": "workspace:*",
    "@apuracao/tse": "workspace:*"
  }
}
