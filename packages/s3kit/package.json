{
  "name": "@apuracao/s3kit",
  "version": "0.0.0",
  "description": "S3 primitives shared by recorder and projector: lease, write-once put",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@apuracao/config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0"
  },
  "files": [
    "dist"
  ]
}
